# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — never commit secrets; keep the example file
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
.cursor/
.env*
# Negation must follow the broad pattern above, or `.env*` re-ignores it (F-15).
!.env.example

# prisma generated client (rebuilt by `npm run db:generate`)
/lib/generated/

# staff media uploads (kept on disk locally; indexed in MediaAsset)
/public/uploads/**
!/public/uploads/.gitkeep

# B2B KYC documents (trade licence / NID) — sensitive, never committed
/private-uploads/

# catalogue bundle written by `npm run catalog:export` (product data + uploads)
/catalog-export/
