  timezone       String   @default("Asia/Dhaka")
  taxId          String?
  /// Public path for the store logo (e.g. `/uploads/general/...`). One logo:
  /// the storefront has no light mode, so there is a single chrome to serve.
  logoSrc        String?
  /// Rendered logo height in CSS pixels. Width follows the artwork's own
  /// aspect ratio, so this is the only dimension an admin needs to set.
  logoHeightPx   Int      @default(32)
  faviconSrc     String?
  currency       Currency @default(BDT)
  currencySymbol String   @default("৳")
  /// Display-only formatting (AD-006: BDT is the only enabled currency in v1).
  currencyDecimalPlaces   Int    @default(0)
  /// "before" | "after"
  currencySymbolPosition  String @default("before")
  updatedAt      DateTime @updatedAt
}

/// Store operations configuration — the seven "Setup & Configurations"
/// sub-pages (order config, VAT/tax, pickup points, invoice, order tracking,
/// shipping label, thermal printer). Kept as one singleton rather than seven
/// near-empty tables: ~16 fields total, all owned by one admin section and one
/// permission (`business.manage`). Identity/contact fields stay on
/// `SiteSettings` — this model deliberately does not duplicate them.
model StoreOperationsSettings {
  id String @id @default("singleton")

  // Order configuration
  orderCodePrefix       String  @default("TH-")
  minimumOrderAmount    Int     @default(0)
  autoConfirmPaidOrders Boolean @default(false)

  // VAT, tax & other charges. Rate is stored in basis points (1500 = 15.00%)
  // so reduced rates such as 7.5% are representable without floating point.
  vatRateBasisPoints  Int     @default(0)
  serviceChargeAmount Int     @default(0)
  taxIncludedInPrice  Boolean @default(true)

  // Pickup points
  pickupEnabled      Boolean @default(true)
  defaultPickupPoint String  @default("dhaka-showroom")

  // Invoice
  invoicePrefix String @default("INV-")
  invoiceFooter String @default("")

  // Order tracking
  trackingUrlTemplate  String  @default("")
  notifyOnStatusChange Boolean @default(true)

  // Shipping label
  labelSize     String  @default("4x6")
  labelShowLogo Boolean @default(true)

  // Thermal printer
  thermalPrinterEnabled Boolean @default(false)
  thermalPaperWidthMm   Int     @default(80)

  updatedAt DateTime @updatedAt
}

/// Storefront footer widgets (AD-230). One JSON document drives columns,
/// social links, about copy, copyright, and display toggles.
model FooterSettings {
  id         String   @id @default("singleton")
  configJson String   @default("{}")
  updatedAt  DateTime @updatedAt
}

/// Real static-content pages (AD-273) — About/Contact/FAQ/Support/Warranty/
/// Shipping/Returns/Terms. `slug` is restricted to a fixed known set (see
/// CONTENT_PAGE_SLUGS in lib/content/pages.ts) since each maps to an
/// existing static storefront route, not an arbitrary new one. `body` is
/// real HTML, sanitized server-side on every save AND again at render time
/// (same allowlist as the blog post body, AD-264) — never trust stored
/// HTML as safe on its own.
model ContentPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  body            String   @default("")
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])
  updatedAt       DateTime @updatedAt
}

/// Design Studio theme settings (AD-272): real storefront brand colors,
/// body/heading font choice, auth-page colors, and admin-navbar colors.
/// Watermark fields are saved for real but automatic watermarking on
/// upload is not implemented yet — disclosed in the admin UI, same
/// pattern as this app's other persisted-but-not-yet-enforced settings.
model DesignThemeSettings {
  id String @id @default("singleton")

  /// Storefront brand colours. All nullable: null means "use the built-in
  /// default from app/globals.css", which is how a fresh install and an
  /// install that has never opened the Appearance page stay identical.
  ///
  /// The column name is NOT the CSS variable name, and the mapping is not
  /// always obvious (`themeAccentColor` drives `--color-secondary`). The
  /// authoritative map is `THEME_COLOR_TOKENS` in lib/design/theme-settings.ts
  /// — that table, not these names, decides what any value can affect.
  themeBaseColor   String?
  themeAccentColor String?
  themeHoverColor  String?
  themeSoftColor   String?

  /// Added for Admin -> Appearance. Each drives a token that already exists in
  /// app/globals.css and is already consumed by Tailwind utilities across the
  /// storefront, so setting one retints every component that uses it without
  /// any component change.
  themeTextColor       String?
  themeBackgroundColor String?
  themeSurfaceColor    String?
  themeBorderColor     String?
  /// The logo's glow blue (`--color-primary-bright`) — the accent that stays
  /// legible on the dark navy panels, where plain primary measures 2.92:1.
  themeBrightColor     String?
  /// Foreground on filled primary surfaces (`--color-primary-foreground`),
  /// i.e. the text colour of a primary button.
  themeOnPrimaryColor  String?

  /// Site chrome: the dark bands at the top and bottom of every page. Split
  /// from `themeTextColor` so the chrome can be retinted for a campaign
  /// without recolouring every paragraph on the site.
  themeHeaderBgColor   String?
  themeHeaderTextColor String?
  themeFooterBgColor   String?
  themeFooterTextColor String?

  watermarkEnabled  Boolean @default(false)
  watermarkType     String  @default("image")
  watermarkImageSrc String?
  watermarkPosition String?

  /// "inter" | "noto-bengali" | "system-ui" | null (site default)
  bodyFont    String?
  headingFont String?

  authBgColor         String?
  authPanelColor      String?
  authIllustrationSrc String?

  adminNavBgColor   String?
  adminNavTextColor String?

  updatedAt DateTime @updatedAt
}

/// Real homepage promotional banners (AD-272) — replaces the previously
/// hardcoded demo banners in lib/catalog/promo-banners.ts. `slot` groups
/// banners by placement: "flash-wide" (single wide strip), "promo-tile"
/// (paired tiles), "category" (category listing banners).
model HomeBanner {
  id       String  @id @default(cuid())
  slot     String
  eyebrow  String
  title    String
  text     String?
  cta      String
  href     String
  imageSrc String
  imageAlt String
  position Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slot, isActive, position])
}

/// Global refund policy (AD-233). Category-day map is JSON keyed by category slug.
model RefundSettings {
  id               String   @id @default("singleton")
  /// "global" | "category"
  refundType       String   @default("global")
  globalRefundDays Int      @default(7)
  disputeEnabled   Boolean  @default(false)
  disputeDays      Int      @default(3)
  /// Public path for PDP refund sticker (e.g. `/uploads/general/...`).
  stickerSrc       String?
  /// JSON: { [categorySlug]: days }
  categoryDaysJson String   @default("{}")
  updatedAt        DateTime @updatedAt
}

/// OTP/SMS gateway settings (P16-T03). API keys and secrets belong in
/// environment variables, never in this table. Sending and verifying OTP
/// codes is deferred until a dedicated auth flow exists.
model OtpSmsConfiguration {
  id              String   @id @default("singleton")
  provider        String   @default("local-mock")
  senderId        String?
  otpLength       Int      @default(6)
  expiryMinutes   Int      @default(5)
  otpLogin        Boolean  @default(false)
  otpRegistration Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

/// Outbound email settings (P16-T04). SMTP passwords belong in environment
/// variables, never in this table. Real mail send is deferred.
model SmtpConfiguration {
  id           String   @id @default("singleton")
  mailerType   String   @default("smtp")
  host         String?
  port         Int      @default(587)
  username     String?
  encryption   String   @default("tls")
  fromAddress  String?
  fromName     String?
  updatedAt    DateTime @updatedAt
}

/// Merchant gateway credentials for checkout (AD-207).
/// Secret fields are AES-GCM ciphertext (GATEWAY_SECRETS_KEY). Never expose
/// decrypted values to Client Components.
model PaymentGatewaySetting {
  id                   String   @id @default(cuid())
  /// sslcommerz | bkash | nagad | cod
  provider             String   @unique
  enabled              Boolean  @default(false)
  /// When true, use provider sandbox hosts (`live: false` in adapters).
  sandbox              Boolean  @default(true)
  /// Non-secret public ids (e.g. SSLCommerz store id, bKash username).
  publicConfigJson     String   @default("{}")
  /// Encrypted JSON blob of secret fields for this provider.
  secretsCiphertext    String?
  secretsUpdatedAt     DateTime?
  updatedByStaffId     String?
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())

  @@index([enabled])
}

/// File system / storage driver + cache settings (Admin → Settings →
/// Filesystem). Persisted config only — uploads always write to local disk
/// (lib/media/admin-media.ts) and cache/sessions use their existing
/// backend regardless of these values; no S3/Backblaze/Redis client exists
/// to actually switch to. Secrets are encrypted with STORAGE_SECRETS_KEY
/// (env-only, never stored in plaintext) via lib/storage/secret-crypto.ts.
model FilesystemSettings {
  id                     String   @id @default("singleton")
  localActive            Boolean  @default(true)
  s3Active               Boolean  @default(false)
  s3Key                  String?
  s3Region               String?
  s3Bucket               String?
  s3SecretCiphertext     String?
  backblazeActive        Boolean  @default(false)
  backblazeKeyId         String?
  backblazeBucket        String?
  backblazeRegion        String?
  backblazeKeyCiphertext String?
  cacheDriver            String   @default("file")
  sessionDriver          String   @default("file")
  redisHost              String?
  redisPort              Int?
  redisPasswordCiphertext String?
  updatedAt              DateTime @updatedAt
}

/// Admin → Settings → Feature Activation toggles. Persisted state only —
/// none of these flags gate live storefront/checkout behavior yet (no
/// enforcement code reads them). See lib/admin/feature-flags-shared.ts for
/// the fixed set of known flag ids and their defaults.
model FeatureFlagSetting {
  id        String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Storefront locale list (Admin → Settings → Languages). No i18n runtime
/// exists yet (no translation storage, no locale routing) — this persists
/// which locales are enabled/default/RTL, not live translated content.
model LanguageSetting {
  code      String   @id
  label     String
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false)
  rtl       Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Courier API credentials (Pathao/Steadfast — Admin → Shipping → Select
/// Shipping Method). Secrets encrypted via COURIER_SECRETS_KEY, mirrors
/// PaymentGatewaySetting's shape exactly. Used to actually create parcels
/// from Admin → Orders ("Send to Pathao/Steadfast", AD-253).
model CourierSetting {
  id                String    @id @default(cuid())
  /// pathao | steadfast
  provider          String    @unique
  enabled           Boolean   @default(false)
  publicConfigJson  String    @default("{}")
  secretsCiphertext String?
  secretsUpdatedAt  DateTime?
  updatedByStaffId  String?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())

  @@index([enabled])
}

/// Cash-on-delivery display + availability (Admin → Payments → Offline).
model OfflinePaymentSettings {
  id           String   @id @default("singleton")
  codEnabled   Boolean  @default(true)
  label        String   @default("Cash on delivery")
  instructions String   @default("Pay in cash when the order arrives.")
  updatedAt    DateTime @updatedAt
}

/// EMI teaser display on the PDP (Admin → Payments → EMI). Display-only —
/// no EMI lender/approval backend exists; this only controls what shows.
model EmiSettings {
  id               String  @id @default("singleton")
  enabled          Boolean @default(false)
  /// JSON array of enabled tenure months, e.g. [3,6,12].
  tenureMonthsJson String  @default("[3,6,12]")
  partnerName      String?
  interestNote     String?
  minOrderAmount   Int     @default(0)
  updatedAt        DateTime @updatedAt
}

enum SocialLoginProvider {
  GOOGLE
  FACEBOOK
  TWITTER
  APPLE
}

/// Customer OAuth login providers (P16-T05). Client secrets belong in
/// environment variables, never in this table. Live OAuth is deferred.
model SocialLoginConfiguration {
  id             String              @id @default(cuid())
  provider       SocialLoginProvider @unique
  isEnabled      Boolean             @default(false)
  publicClientId String?
  updatedAt      DateTime            @updatedAt
}

/// Real OAuth2 account link (Phase 9, Google + Facebook). One row per
/// provider identity a customer has signed in with — looked up first on
/// every social login before falling back to matching/creating by email.
model SocialLoginAccount {
  id                String              @id @default(cuid())
  provider          SocialLoginProvider
  providerAccountId String
  userId            String
  createdAt         DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Google reCAPTCHA v3 settings (P16-T05). Secret key belongs in environment
/// variables. Widget/verify wiring is deferred.
model RecaptchaConfiguration {
  id                       String   @id @default("singleton")
  isEnabled                Boolean  @default(false)
  siteKey                  String?
  scoreThreshold           Float    @default(0.5)
  pageAdminLogin           Boolean  @default(false)
  pageCustomerLogin        Boolean  @default(false)
  pageCustomerRegistration Boolean  @default(false)
  pageForgotPassword       Boolean  @default(false)
  pageContactUs            Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

/// Firebase enable flag (P16-T05). Project credentials stay in env. Push
/// / analytics wiring is deferred.
model FirebaseConfiguration {
  id        String   @id @default("singleton")
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Google Maps enable flag (P16-T06). API keys belong in environment
/// variables. Maps JavaScript / Places wiring is deferred.
model GoogleMapConfiguration {
  id        String   @id @default("singleton")
  isEnabled Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

enum ChatWidgetProvider {
  WHATSAPP
  MESSENGER
  TAWKTO
}

/// Storefront chat shortcuts (P16-T06). Public handles only (phone / page
/// id / Tawk.to property+widget id). Raw scripts are never stored. Tawk.to
/// renders a real live chat widget on the storefront when enabled
/// (AD-249); WhatsApp/Messenger stay intent-only (no floating buttons yet).
model ChatWidgetConfiguration {
  id           String             @id @default(cuid())
  provider     ChatWidgetProvider @unique
  isEnabled    Boolean            @default(false)
  publicHandle String?
  updatedAt    DateTime           @updatedAt
}

/// Social comment plugin settings (P16-T06). Public app id only. Plugin
/// embed wiring is deferred. Raw scripts are never stored.
model CommentSystemConfiguration {
  id          String   @id @default("singleton")
  isEnabled   Boolean  @default(false)
  provider    String   @default("facebook")
  publicAppId String?
  updatedAt   DateTime @updatedAt
}

/// Per-page or global SEO defaults. `path` is null for the global record.
model SEOConfiguration {
  id             String   @id @default(cuid())
  path           String?  @unique
  title          String?
  description    String?
  keywords       String[]
  ogImageMediaId String?
  /// Sanitized long-form SEO copy rendered on the page itself, not in <head>.
  /// Lives on the per-path row (the homepage block is path "/"); the
  /// site-wide defaults row (path null) only carries meta fields.
  contentHtml    String?
  updatedAt      DateTime @updatedAt
}

enum AnalyticsProvider {
  GA4
  GTM
  META_PIXEL
  MERCHANT_CENTER
}

/// Raw <script> markup injected verbatim into the storefront head/body end.
/// Not sanitized — sanitizing would defeat the feature's purpose (running
/// third-party tracking/chat snippets). Access is the real control: gated
/// on custom_scripts.manage, granted to the Admin role only.
model CustomScriptSettings {
  id           String   @id @default("singleton")
  headerScript String?
  footerScript String?
  updatedAt    DateTime @updatedAt
}

/// Public measurement ids only (tracking id, pixel id). API tokens and secrets
/// belong in environment variables, never in the database.
model AnalyticsConfiguration {
  id        String            @id @default(cuid())
  provider  AnalyticsProvider @unique
  isEnabled Boolean           @default(false)
  publicId  String?
  notes     String?
  updatedAt DateTime          @updatedAt
}

/// Append-only trail for privileged actions. Never store credentials or raw
/// personal data here; `ipHash` is hashed, not the address itself.
model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  actorLabel String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorType, actorId])
  @@index([createdAt])
}

/// Auth attempt counters (P11-T06). `bucketKey` is hashed (IP or email), never
/// the raw value. Rows are a rolling window, not an audit trail.
model AuthRateLimit {
  bucketKey   String   @id
  windowStart DateTime
  count       Int
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

enum OtpChallengePurpose {
  LOGIN
  REGISTRATION
}

/// Real OTP 2FA challenge (Phase 9). Login: created after a correct
/// password when Enable OTP for login is on and the account has a phone
/// number — the session is only created once the code is verified.
/// Registration: created after the registration form validates when Enable
/// OTP for registration is on — the account itself (and its session) is
/// only created once the code is verified; `pending*` fields hold the
/// not-yet-created account until then. Both the challenge token and the
/// code are stored hashed, never in plaintext (matches session token
/// hashing in lib/auth/session-token.ts).
model OtpChallenge {
  id          String              @id @default(cuid())
  tokenHash   String              @unique
  purpose     OtpChallengePurpose
  phone       String
  codeHash    String
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime            @default(now())

  /// LOGIN only — the already-existing account this challenge is for.
  userId String?

  /// REGISTRATION only — the not-yet-created account's data.
  pendingFullName     String?
  pendingEmail        String?
  pendingPhone        String?
  pendingPasswordHash String?

  @@index([phone])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Marketing — Notifications, Popups, Visitor tracking (AD-258)
// ---------------------------------------------------------------------------

enum NotificationAudience {
  CUSTOMER
  ADMIN
}

/// Admin-configurable catalogue of notification types (Admin → Notifications →
/// Types). Real CRUD, but not yet wired to automatic order-lifecycle triggers
/// (no code currently creates a Notification keyed to one of these) — that is
/// a separate, larger task. `isLocked` types ship as defaults and cannot be
/// deleted from the admin UI, but their text/enabled state can still change.
model NotificationTypeSetting {
  id          String               @id @default(cuid())
  name        String               @unique
  defaultText String
  audience    NotificationAudience @default(CUSTOMER)
  enabled     Boolean              @default(true)
  isLocked    Boolean              @default(false)
  position    Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

/// Global messaging-channel defaults (Admin → Notifications → Settings).
/// Real persistence; does not itself gate whether email/SMS actually send —
/// "Send custom" only ever creates in-app rows today.
model NotificationSettings {
  id           String   @id @default("singleton")
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(true)
  pushEnabled  Boolean  @default(false)
  fromName     String   @default("Techno House")
  updatedAt    DateTime @updatedAt
}

/// Admin-authored storefront pop-up (Admin → Marketing → Dynamic Pop-ups).
/// Rendered for real on the storefront (AD-258) — at most one shown per
/// visitor per browser session (tracked client-side via localStorage).
model Popup {
  id             String   @id @default(cuid())
  title          String
  summary        String
  imagePath      String?
  buttonText     String?
  buttonColor    String   @default("#eab308")
  buttonTextTone String   @default("dark")
  link           String?
  /// Seconds after page load before the pop-up appears.
  delaySeconds   Int      @default(3)
  enabled        Boolean  @default(false)
  isLocked       Boolean  @default(false)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// One real page-view event, keyed to an anonymous per-browser id (a random
/// cookie value — never an IP address or account id) so the "N people
/// viewing" widget reflects genuine distinct visitors, not fabricated
/// numbers. Pruned periodically by the recording path; this is a rolling
/// window table, not an analytics warehouse.
model ProductViewEvent {
  id         String   @id @default(cuid())
  productId  String
  viewerKey  String
  viewedAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, viewedAt])
}

/// Admin config for the real "N people are viewing this" PDP widget
/// (Admin → Marketing → Custom Visitors).
model VisitorWidgetSettings {
  id             String   @id @default("singleton")
  enabled        Boolean  @default(false)
  windowMinutes  Int      @default(15)
  minToShow      Int      @default(2)
  updatedAt      DateTime @updatedAt
}

/// Admin-authored storefront corner toast (Admin → Marketing → Custom
/// Alerts, AD-259). Rendered for real on the storefront — at most one
/// shown per visitor per browser session (localStorage), separate from
/// the modal Popup above. `location` is one of bottom-left/bottom-right/
/// top-left/top-right; `size` is small/large; `textTone` is light/dark.
model Alert {
  id               String   @id @default(cuid())
  text             String
  linkLabel        String?
  link             String?
  imagePath        String?
  size             String   @default("small")
  backgroundColor  String   @default("#000000")
  textTone         String   @default("light")
  location         String   @default("bottom-left")
  /// Null = no auto-close; otherwise seconds before it dismisses itself.
  autoCloseSeconds Int?
  enabled          Boolean  @default(false)
  isLocked         Boolean  @default(false)
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Admin config for the "Custom Sale Alert" storefront toast (Admin →
/// Marketing → Custom Sale Alert, AD-260) — a rotating "Someone from
/// {area} bought {product}" note. Driven by real OrderItem rows, never
/// fabricated; never shows the customer's name/email/phone, only the
/// real shipping area, to avoid exposing purchaser identity publicly.
/// `productScope` is one of featured/sale/manual; `manualProductIds` only
/// applies when scope is "manual".
model SaleAlertSettings {
  id                 String   @id @default("singleton")
  enabled            Boolean  @default(false)
  minIntervalSeconds Int      @default(15)
  maxIntervalSeconds Int      @default(45)
  productScope       String   @default("featured")
  manualProductIds   String[] @default([])
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Email Templates + Newsletter Campaigns (AD-261)
// ---------------------------------------------------------------------------

enum EmailTemplateAudience {
  ALL
  ADMIN
  CUSTOMER
  COMMON
}

/// Real, editable content for the fixed catalogue of transactional email
/// types (Admin → Marketing → Email Templates). Content only — not yet
/// wired to real order-lifecycle send triggers (no code creates an email
/// keyed to one of these today, same disclosed gap as
/// NotificationTypeSetting); "Send test email" on the edit form is real
/// and uses the same lib/mail/send.ts sender as SMTP/OTP test-sends.
model EmailTemplate {
  id        String                @id @default(cuid())
  key       String                @unique
  emailType String
  subject   String
  body      String
  audience  EmailTemplateAudience @default(CUSTOMER)
  enabled   Boolean               @default(true)
  isLocked  Boolean               @default(false)
  position  Int                   @default(0)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
}

enum NewsletterCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

/// A real newsletter blast sent to subscribed NewsletterSubscriber rows via
/// the existing SMTP sender (lib/mail/send.ts). `sentCount`/`failedCount`
/// are the real, measured per-recipient outcome — never assumed successful.
model NewsletterCampaign {
  id             String                   @id @default(cuid())
  subject        String
  body           String
  status         NewsletterCampaignStatus @default(DRAFT)
  recipientCount Int                      @default(0)
  sentCount      Int                      @default(0)
  failedCount    Int                      @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

enum SmsCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

/// A real bulk SMS blast to real customers with a phone number, sent via
/// the existing single-SMS sender (lib/sms/send.ts) — one HTTP call per
/// recipient, sequential, using whatever provider is configured in
/// Admin → OTP. `sentCount`/`failedCount` are the real, measured
/// per-recipient outcome — never assumed successful. `audience` is one
/// of all/verified/recent, matching the Send Custom Notification pattern.
model SmsCampaign {
  id             String            @id @default(cuid())
  message        String
  audience       String            @default("all")
  status         SmsCampaignStatus @default(DRAFT)
  recipientCount Int               @default(0)
  sentCount      Int               @default(0)
  failedCount    Int               @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}
