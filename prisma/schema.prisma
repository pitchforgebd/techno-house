model SupportMessage {
  id            String    @id @default(cuid())
  ticketId      String
  authorType    ActorType
  authorName    String
  authorStaffId String?
  body          String
  createdAt     DateTime  @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorStaff Staff?        @relation(fields: [authorStaffId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

enum ComplaintStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum ComplaintSource {
  CONTACT_FORM
  PRODUCT_REQUEST
  FOOTER
  /// The support-hub form at /support.
  SUPPORT
}

/// Contact-form messages and product requests: inbound notes that are not
/// full support tickets.
model Complaint {
  id            String          @id @default(cuid())
  userId        String?
  name          String
  email         String
  phone         String?
  subject       String?
  message       String
  /// Set when the source is a product request.
  productWanted String?
  reply         String?
  staffNotes    String?
  status        ComplaintStatus @default(NEW)
