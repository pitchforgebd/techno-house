// Techno House — Prisma schema (P10-T03: initial schema).
//
// Covers the domain entities listed in docs/DATABASE.md and mirrors the shapes
// the app already uses in `lib/data/types` and the admin mocks, so the P10-T06
// repository implementations can map onto it without UI changes.
//
// Conventions
//   - Money is an integer amount in ৳ plus a `currency` column, matching the
//     `Money` type in lib/data/types/common.ts. The server is always the
//     authority for totals (docs/PAYMENT_SECURITY.md).
//   - Snapshot columns on orders (names, SKUs, prices) are intentional: an
//     order must not change when a product is later edited or deleted.
//   - Card data and plaintext passwords are never modelled. Gateway merchant
//     secrets may be stored encrypted in PaymentGatewaySetting (AD-207);
//     GATEWAY_SECRETS_KEY stays in the environment.
//
// Migrations are P10-T04; this task only defines the schema.

generator client {
  // Prisma 7 default generator. `output` is required and writes into the source
  // tree, so the generated client is gitignored and rebuilt by `db:generate`.
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  // Prisma 7 removed `url` from the schema: the CLI reads it from
  // prisma.config.ts, and the client connects through a driver adapter
  // (@prisma/adapter-pg) configured in lib/db/prisma.ts.
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum Currency {
  BDT
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum BuilderSlot {
  CPU
  CPU_COOLER
  MOTHERBOARD
  RAM
  GPU
  SSD
  HDD
  PSU
  CASE
  CASE_FANS
  MONITOR
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
}

// ---------------------------------------------------------------------------
// Identity: customers, staff, RBAC
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  BLOCKED
  INVITED
}

/// Storefront customer. Only a password hash is ever stored — never plaintext.
model User {
  id              String     @id @default(cuid())
  email           String     @unique
  phone           String?    @unique
  passwordHash    String?
  fullName        String
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  isSuspicious    Boolean    @default(false)
  walletAmount    Int        @default(0)
  currency        Currency   @default(BDT)
  city            String?
  notes           String?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  addresses     Address[]
  orders        Order[]
  carts         Cart[]
  wishlist      Wishlist?
  compareList   CompareList?
  reviews       ProductReview[]
  questions     ProductQuestion[]
  tickets       SupportTicket[]
  complaints    Complaint[]
  notifications Notification[]
  pcBuilds      PCBuild[]
  refunds       Refund[]
  b2bAccount    B2BAccount?
  sessions      CustomerSession[]
  walletTransactions WalletTransaction[]
  couponRedemptions  CouponRedemption[]
  socialLoginAccounts SocialLoginAccount[]

  @@index([status])
  @@index([createdAt])
}

/// Real ledger for every User.walletAmount change (AD-270). There is no
/// customer-facing wallet top-up flow today — every row here is an
/// admin-initiated adjustment (see lib/admin/save-customer.ts), not a
/// customer "recharge" via a payment gateway.
model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Int
  balanceAfter  Int
  reason        String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

/// Real storefront search queries (AD-270), for the admin User Searches
/// report. query is stored lowercased/trimmed so grouping by exact text is
/// correct without a separate normalization step at read time.
model SearchLog {
  id          String   @id @default(cuid())
  query       String
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([query])
  @@index([createdAt])
}

/// Opaque customer session (P11-T01). The cookie holds a random token; only
/// `tokenHash` (SHA-256) is stored. Staff sessions are a separate model in T02.
model CustomerSession {
  id         String    @id @default(cuid())
  userId     String
  /// SHA-256 hex of the secret token sent in the cookie.
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Last successful resolve. Touched at most every 10 minutes (P11-T03).
  lastUsedAt DateTime  @default(now())
  /// Hashed client IP — never store the raw address.
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  area         String?
  city         String
  postcode     String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum B2BStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

/// Wholesale account attached to a customer. Uploaded documents are stored as
/// media references, never as raw file blobs.
model B2BAccount {
  id                String    @id @default(cuid())
  userId            String    @unique
  company           String
  contactName       String
  shopAddress       String?
  /// Collected on the B2B registration form. The scanned document, when one
  /// is uploaded later, still goes to `nidMedia`.
  nidNumber         String?
  tier              String?
  /// Fallback wholesale discount for products with no `B2BProductPrice` row.
  discountPercent   Int       @default(0)
  status            B2BStatus @default(PENDING)
  tradeLicenceMedia String?
  nidMedia          String?
  notes             String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Wholesale price and order minimum for one product, applied to verified
/// (ACTIVE) B2B accounts only. A product without a row here falls back to the
/// account's `discountPercent`. Price is stored, never derived at read time,
/// so a later retail price change cannot silently move wholesale pricing.
model B2BProductPrice {
  id          String   @id @default(cuid())
  productId   String   @unique
  priceAmount Int
  /// Smallest quantity a B2B buyer may order of this product.
  minQuantity Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

enum StaffStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Staff {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String?
  fullName     String
  phone        String?
  department   String?
  status       StaffStatus @default(INVITED)
  roleId       String?
  lastActiveAt DateTime?
  /// Consecutive failed sign-ins. Reset to 0 on any successful sign-in.
  ///
  /// Separate from the sliding rate-limit window (`AuthRateLimit`), which
  /// forgets everything after 15 minutes and so only slows an attacker down.
  /// This persists, so a patient attacker still trips the lock (F-05).
  failedLoginAttempts Int      @default(0)
  /// Set when `failedLoginAttempts` crosses the threshold. Sign-in is refused
  /// until this passes, whatever the rate-limit buckets say.
  lockedUntil         DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  role          Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  blogPosts     BlogPost[]
  mediaUploads  MediaAsset[]
  refundActions Refund[]
  ticketReplies SupportMessage[]
  notifications Notification[]
  sessions      StaffSession[]

  @@index([roleId])
  @@index([status])
}

/// Opaque staff session (P11-T02). Separate table and cookie from customers.
/// The cookie holds a random token; only `tokenHash` (SHA-256) is stored.
model StaffSession {
  id         String    @id @default(cuid())
  staffId    String
  /// SHA-256 hex of the secret token sent in the cookie.
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  /// Last successful resolve. Touched at most every 10 minutes (P11-T03).
  lastUsedAt DateTime  @default(now())
  /// Hashed client IP — never store the raw address.
  ipHash     String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  /// System roles cannot be deleted from the admin UI.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff[]
  permissions RolePermission[]
}

/// Permission catalogue, e.g. `orders.view_unpaid`. Grouped for the admin UI.
model Permission {
  id        String   @id @default(cuid())
  key       String   @unique
  groupKey  String
  label     String
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@index([groupKey])
}

model RolePermission {
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  /// Short plain-text summary — meta description and listing subtitles.
  description String?
  /// Rich buying-guide copy shown at the bottom of the category page.
  /// Sanitized HTML (same allowlist as blog bodies), so it can carry
  /// headings, links, and comparison tables. Empty falls back to the built-in
  /// per-category copy in `lib/catalog/category-page-content.ts`.
  seoContentHtml String?
  parentId    String?
  /// Attribute keys exposed as filters on this category's listing.
  filterKeys  String[]
  iconSrc     String?
  bannerSrc   String?
  coverSrc    String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  /// Admin merchandising flags (Phase 4). Not yet consumed by any storefront
  /// section — see TASK_STATE.md.
  isFeatured  Boolean  @default(false)
  isHot       Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products Product[]
  discount CategoryDiscount?

  @@index([parentId])
  @@index([isActive])
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  logoSrc     String?
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
}

/// Sellable unit catalogue (`/admin/units`). Was a hardcoded mock array.
/// Note: `Product` has no unit column yet, so this is a catalogue only — the
/// product form's unit dropdown is still not persisted (see TASK_STATE.md).
model ProductUnit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Preset product notes (`/admin/notes`), referenced by `Product.noteIds`.
/// Seeded from the previous mock catalogue using the same ids so existing
/// product associations keep resolving.
model ProductNotePreset {
  id          String   @id @default(cuid())
  type        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
}

/// Storefront badge presets (`/admin/labels`), referenced by `Product.labelIds`.
/// Same id-preserving seed rationale as ProductNotePreset.
model ProductLabelPreset {
  id              String   @id @default(cuid())
  text            String
  backgroundColor String
  /// "light" | "dark" — controls badge text colour.
  textTone        String   @default("light")
  /// System labels cannot be deleted from the admin UI.
  isSystem        Boolean  @default(false)
  /// Inactive labels are hidden from the storefront and from product pickers.
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

model ProductWarranty {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  months      Int?
  description String?
  /// Uploaded 40x40 mark shown instead of the auto-generated text badge
  /// (warrantyBadgeFromLabel) when set. Admin -> Warranty -> Edit.
  logoSrc     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id         String  @id @default(cuid())
  slug       String  @unique
  sku        String  @unique
  /// Retailer/manufacturer barcode (EAN/UPC or an internally generated code).
  /// Nullable + unique: Postgres allows multiple NULLs under a unique index,
  /// so products without a scanned barcode don't collide with each other.
  barcode    String? @unique
  name       String
  brandId    String
  categoryId String
  warrantyId String?

  /// Short paragraphs shown above the specification table.
  overview        String[]
  priceAmount     Int
  compareAtAmount Int?
  /// Inclusive calendar start for the compare-at / sale offer (UTC date).
  discountStartsAt DateTime?
  /// Inclusive calendar end for the compare-at / sale offer (UTC date).
  discountEndsAt   DateTime?
  currency        Currency    @default(BDT)
  /// Denormalised from ProductStock for listing queries; the domain layer keeps
  /// it in sync.
  stockStatus     StockStatus @default(IN_STOCK)
  isNew           Boolean     @default(false)
  isSale          Boolean     @default(false)
  isActive        Boolean     @default(true)
  /// Assigned to the Promotional Products channel (`/admin/promotions/products`).
  /// Merchandising only, and deliberately separate from `isSale` (Today's Deal)
  /// so the two channels can hold different products.
  isPromotional   Boolean     @default(false)
  /// Storefront featured / catalogue order. Lower number appears first.
  position        Int         @default(0)
  /// Shipping weight in grams — feeds the weight-based zone rate (AD-254).
  weightGrams     Int         @default(500)

  /// PC Builder classification. Null for products that are not build parts.
  builderSlot             BuilderSlot?
  builderSocket           String?
  builderRamType          String?
  builderFormFactor       String?
  builderTdpWatts         Int?
  /// SSD/HDD <-> motherboard interface (AD-276). "NVMe" | "SATA".
  builderStorageInterface String?

  /// Optional YouTube watch / Shorts / youtu.be URL for the product page.
  youtubeUrl           String?
  /// Local public path or https URL to a PDF specification sheet.
  pdfSpecificationSrc  String?

  /// Admin → Notes presets attached to this product (mock catalogue ids for now).
  noteIds  String[] @default([])
  /// Admin → Labels presets attached to this product (mock catalogue ids for now).
  labelIds String[] @default([])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  brand    Brand            @relation(fields: [brandId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  warranty ProductWarranty? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)

  images          ProductImage[]
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  specChips       ProductSpecChip[]
  specGroups      ProductSpecGroup[]
  colors          ProductColor[]
  stock           ProductStock?
  reviews         ProductReview[]
  questions       ProductQuestion[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  compareItems    CompareListItem[]
  flashSaleItems  FlashSaleItem[]
  promotionItems  PromotionProduct[]
  buildItems      PCBuildItem[]
  viewEvents      ProductViewEvent[]
  b2bPrice        B2BProductPrice?

  relatedTo   Product[] @relation("RelatedProducts")
  relatedFrom Product[] @relation("RelatedProducts")

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, publishedAt])
  @@index([isActive, position])
  @@index([priceAmount])
  @@index([builderSlot])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  src       String
  alt       String
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  sku             String   @unique
  name            String
  priceAmount     Int
  compareAtAmount Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  stock      ProductStock?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

/// Attribute definition. Drives listing facets and filtering only — the
/// machine-comparable value ("512GB"), not the wording shown to a shopper
/// ("512GB SSD"), which lives in ProductSpecChip / ProductSpecRow.
model ProductAttribute {
  id            String   @id @default(cuid())
  key           String   @unique
  label         String
  unit          String?
  isFilterable  Boolean  @default(false)
  /// Suggested filter values shown in admin. Facets still come from product values.
  allowedValues String[] @default([])
  position      Int      @default(0)
  createdAt     DateTime @default(now())

  values ProductAttributeValue[]
}

model ProductAttributeValue {
  id          String @id @default(cuid())
  productId   String
  attributeId String
  value       String
  position    Int    @default(0)

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
  @@index([attributeId, value])
}

/// Selectable product colours (name + optional hex swatch). Stock is shared
/// at product level for this lighter model; each colour can still be ordered.
model ProductColor {
  id        String   @id @default(cuid())
  productId String
  name      String
  /// Optional #RGB or #RRGGBB for storefront swatches.
  hex       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product   Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  images    ProductColorImage[]
  cartItems CartItem[]

  @@unique([productId, name])
  @@index([productId, position])
}

/// Gallery images for one product colour. When empty, the storefront falls
/// back to the product-level ProductImage set.
model ProductColorImage {
  id       String @id @default(cuid())
  colorId  String
  src      String
  alt      String
  position Int    @default(0)

  color ProductColor @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@index([colorId, position])
}

/// Summary chips on the product card, in display order.
///
/// Stored per product rather than derived from attributes: the chip wording
/// differs from the filterable value ("512GB SSD" vs "512GB"), and some
/// products have chips with no corresponding attribute at all.
model ProductSpecChip {
  id        String @id @default(cuid())
  productId String
  label     String
  value     String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

/// One section of the specification table on the product page.
///
/// The grouping belongs to the product, not to the attribute: `storage` sits
/// under "Core" on a laptop and under "Phone" on a handset, so it cannot be a
/// column on ProductAttribute.
model ProductSpecGroup {
  id        String @id @default(cuid())
  productId String
  title     String
  position  Int    @default(0)

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  rows    ProductSpecRow[]

  @@unique([productId, title])
  @@index([productId, position])
}

model ProductSpecRow {
  id       String @id @default(cuid())
  groupId  String
  label    String
  value    String
  position Int    @default(0)

  group ProductSpecGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, position])
}

/// Stock for a product or one of its variants.
model ProductStock {
  id                String   @id @default(cuid())
  productId         String?  @unique
  variantId         String?  @unique
  quantity          Int      @default(0)
  /// Held by pending orders; available = quantity - reserved.
  reserved          Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Reviews and questions
// ---------------------------------------------------------------------------

enum ModerationStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model ProductReview {
  id           String           @id @default(cuid())
  productId    String
  userId       String?
  authorName   String
  rating       Int
  title        String?
  body         String
  status       ModerationStatus @default(PENDING)
  /// Seeded/editorial reviews entered by staff rather than customers.
  isStaffEntry Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([userId])
}

enum QuestionStatus {
  PENDING
  ANSWERED
}

model ProductQuestion {
  id         String         @id @default(cuid())
  productId  String
  userId     String?
  askerName  String
  askerEmail String?
  question   String
  answer     String?
  answeredBy String?
  answeredAt DateTime?
  status     QuestionStatus @default(PENDING)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

// ---------------------------------------------------------------------------
// Cart, wishlist, compare
// ---------------------------------------------------------------------------

model Cart {
  id               String   @id @default(cuid())
  userId           String?
  /// Guest carts are keyed by an opaque cookie token.
  sessionToken     String?  @unique
  couponCode       String?
  shippingMethodId String?
  shippingAreaId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shippingArea   ShippingArea?   @relation(fields: [shippingAreaId], references: [id], onDelete: SetNull)
  items          CartItem[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  colorId   String?
  quantity  Int      @default(1)
  /// Set when this line was added via "Add build to cart" (AD-276) — lets a
  /// real order later show which items came from the same PC build, without
  /// a hard FK to PCBuild (a saved build can be pruned independently).
  buildBatchId String?
  /// Which PC Builder slot this line filled, when buildBatchId is set.
  builderSlot  BuilderSlot?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  color   ProductColor?   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId, colorId])
  @@index([productId])
  @@index([colorId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  addedAt    DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([productId])
}

model CompareList {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CompareListItem[]
}

model CompareListItem {
  id            String   @id @default(cuid())
  compareListId String
  productId     String
  addedAt       DateTime @default(now())

  compareList CompareList @relation(fields: [compareListId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([compareListId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Orders, payments, refunds
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

/// Where an order currently stands with respect to the stock it claimed.
///
/// Separate from `OrderStatus` on purpose: status is the customer-facing
/// lifecycle, this is the inventory ledger. It exists so a reservation can be
/// released exactly once even though release is reachable from two independent
/// paths (order cancellation and payment failure), and so the release is
/// reversible when an admin moves a cancelled order back to PENDING.
enum OrderStockState {
  /// Units are held against ProductStock.reserved.
  RESERVED
  /// Units were returned to available stock (cancelled / failed payment).
  RELEASED
  /// Goods were delivered — the reservation became a real quantity decrement.
  CONVERTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id     String  @id @default(cuid())
  /// The customer-facing Order ID, and the only identifier that should appear
  /// outside this table. Digits only for every order created since the
  /// `order_number_seq` sequence was introduced; orders predating it keep
  /// their `TH-YYYYMMDD-XXXXXXXX` numbers and are never renumbered, because
  /// those are already printed on invoices and recorded at the gateways.
  /// `Order_number_format` enforces both shapes and forbids anything else.
  number String  @unique
  userId String?

  /// Contact snapshot: an order stays readable if the account is deleted.
  customerName  String
  customerEmail String
  customerPhone String

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  /// Inventory ledger state — see `OrderStockState`. Every order starts holding
  /// its reservation, which is what `create-order` writes.
  stockState    OrderStockState @default(RESERVED)

  currency       Currency @default(BDT)
  subtotalAmount Int
  discountAmount Int      @default(0)
  shippingAmount Int      @default(0)
  taxAmount      Int      @default(0)
  /// Flat per-order charge from `StoreOperationsSettings.serviceChargeAmount`,
  /// snapshotted at placement. Its own column rather than being folded into
  /// `shippingAmount` or `taxAmount`: those have specific meanings on an
  /// invoice and in any tax return, and a service charge is neither.
  serviceChargeAmount Int  @default(0)
  totalAmount    Int

  couponId   String?
  couponCode String?

  shippingMethodId    String?
  shippingMethodLabel String?
  shippingAreaId      String?
  /// Address snapshot at the time of ordering.
  shippingAddress     String
  billingAddress      String?

  notes        String?
  staffNotes   String?
  trackingCode String?
  carrierId    String?

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon         Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  shippingMethod ShippingMethod?  @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shippingArea   ShippingArea?    @relation(fields: [shippingAreaId], references: [id], onDelete: SetNull)
  carrier        ShippingCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  payments Payment[]
  refunds  Refund[]
  tickets  SupportTicket[]

  couponRedemption CouponRedemption?

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  variantId String?

  /// Snapshots: the line must not change if the product is edited later.
  productName String
  sku         String
  unitAmount  Int
  quantity    Int
  totalAmount Int
  /// Selected colour snapshot (name + optional hex) when ordered.
  colorName   String?
  colorHex    String?
  /// Set when this line came from "Add build to cart" (AD-276) — real PC
  /// Builder order traceability, carried from the cart line at checkout.
  buildBatchId String?
  builderSlot  BuilderSlot?

  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

/// A payment attempt against an order. Only gateway references are stored —
/// never card numbers, wallet PINs, or gateway secrets.
model Payment {
  id       String  @id @default(cuid())
  orderId  String
  provider String
  method   String?

  status   PaymentStatus @default(PENDING)
  amount   Int
  currency Currency      @default(BDT)

  /// Gateway transaction id. Unique per provider so a replayed webhook cannot
  /// create a second payment (docs/PAYMENT_SECURITY.md).
  transactionRef String?
  /// Hosted session id (bKash paymentID / SSLCommerz sessionkey). Kept after
  /// PAID so a later refund can call the gateway.
  sessionRef String?
  /// Caller-supplied key that makes retried requests safe.
  idempotencyKey String? @unique
  failureReason  String?

  authorizedAt DateTime?
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds Refund[]

  @@unique([provider, transactionRef])
  @@index([orderId])
  @@index([status])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum RefundChannel {
  WALLET
  OFFLINE
  GATEWAY
}

enum RefundPayoutStatus {
  PENDING
  /// Claimed by a completion attempt that is calling the gateway right now.
  /// The claim is what makes the payout single-shot: only one caller can move
  /// a refund PENDING -> PROCESSING, so only that caller reaches the gateway.
  PROCESSING
  PAID
}

model RefundReason {
  id        String    @id @default(cuid())
  /// CUSTOMER reasons are pickable at request time; ADMIN_REJECT reasons are
  /// used when declining one.
  type      ActorType @default(CUSTOMER)
  reason    String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  refunds Refund[]
}

model Refund {
  id            String  @id @default(cuid())
  code          String  @unique
  orderId       String
  paymentId     String?
  requestedById String?
  approvedById  String?
  reasonId      String?

  amount   Int
  currency Currency @default(BDT)

  status       RefundStatus       @default(REQUESTED)
  channel      RefundChannel      @default(GATEWAY)
  payoutStatus RefundPayoutStatus @default(PENDING)
  reasonText   String?
  isDispute    Boolean            @default(false)
  /// Gateway refund reference. Unique so a retried complete cannot pay out twice.
  payoutRef    String?            @unique

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  requestedBy User?         @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  approvedBy  Staff?        @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  reason      RefundReason? @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  events      RefundEvent[]

  @@index([orderId])
  @@index([status])
  @@index([isDispute])
}

model RefundEvent {
  id        String    @id @default(cuid())
  refundId  String
  actorType ActorType
  actorName String
  message   String
  createdAt DateTime  @default(now())

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId, createdAt])
}

// ---------------------------------------------------------------------------
// Marketing: coupons, promotions, flash sales
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
}

enum DiscountKind {
  PERCENT
  FIXED
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  kind           DiscountKind @default(PERCENT)
  value          Int
  label          String?
  minSpendAmount Int?
  usageLimit     Int?
  /// How many times ONE customer may redeem this coupon. `null` means no
  /// per-customer cap, which is the behaviour that existed before this field
  /// and remains the default — `usageLimit` alone caps the total across
  /// everyone, so a coupon with no global limit could be reused indefinitely
  /// by a single account (DSA-14).
  perUserLimit   Int?
  /// Maintained transactionally when an order is placed.
  usageCount     Int          @default(0)
  isActive       Boolean      @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders      Order[]
  redemptions CouponRedemption[]

  @@index([isActive, startsAt, endsAt])
}

/// One customer's use of one coupon on one order.
///
/// Written in the same transaction that creates the order and increments
/// `Coupon.usageCount`, so the ledger cannot drift from the counter. Exists
/// because `usageCount` alone cannot answer "has THIS customer used it
/// before?" — which is what a per-customer cap needs (DSA-14).
model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([userId])
}

enum PromotionKind {
  PROMOTION
  DEAL
}

enum PromotionChannel {
  HOMEPAGE
  CATEGORY
  SITEWIDE
}

model Promotion {
  id        String           @id @default(cuid())
  slug      String           @unique
  name      String
  kind      PromotionKind    @default(PROMOTION)
  channel   PromotionChannel @default(HOMEPAGE)
  status    CampaignStatus   @default(DRAFT)
  summary   String?
  priority  Int              @default(0)
  /// Offer artwork shown on /offers. The banner carries the whole message.
  bannerSrc String?
  /// Short category word for the rotated strip down the banner's left edge
  /// (e.g. "MONITOR"). Falls back to the channel when unset.
  bannerLabel String?
  /// Where the banner links. Local storefront path only.
  bannerHref  String?
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  products PromotionProduct[]

  @@index([status, startsAt, endsAt])
}

model PromotionProduct {
  promotionId String
  productId   String
  position    Int    @default(0)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model FlashSale {
  id                 String         @id @default(cuid())
  slug               String         @unique
  title              String
  status             CampaignStatus @default(DRAFT)
  isFeatured         Boolean        @default(false)
  bannerSrc          String?
  maxDiscountPercent Int?
  startsAt           DateTime
  endsAt             DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  items FlashSaleItem[]

  @@index([status, startsAt, endsAt])
}

model FlashSaleItem {
  flashSaleId     String
  productId       String
  discountPercent Int?
  priceAmount     Int?
  /// Optional cap on units sold at the campaign price.
  quantityLimit   Int?

  flashSale FlashSale @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([flashSaleId, productId])
  @@index([productId])
}

/// Percentage discount applied to every product in a category for a window.
model CategoryDiscount {
  id              String    @id @default(cuid())
  categoryId      String    @unique
  discountPercent Int
  startsAt        DateTime?
  endsAt          DateTime?
  isActive        Boolean   @default(true)
  updatedAt       DateTime  @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Shipping
// ---------------------------------------------------------------------------

model ShippingCountry {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  states ShippingState[]
}

model ShippingState {
  id        String   @id @default(cuid())
  countryId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  country ShippingCountry @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities  ShippingCity[]

  @@unique([countryId, name])
}

model ShippingCity {
  id        String   @id @default(cuid())
  stateId   String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  state ShippingState  @relation(fields: [stateId], references: [id], onDelete: Cascade)
  areas ShippingArea[]

  @@unique([stateId, name])
}

model ShippingZone {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  /// Weight-based rate (AD-254): baseRateAmount covers the first
  /// baseWeightGrams; extraRatePerKgAmount applies per additional kg
  /// beyond that. Replaces ShippingMethod.baseRateAmount as the price
  /// source for non-pickup methods.
  baseWeightGrams      Int      @default(1000)
  baseRateAmount       Int      @default(0)
  extraRatePerKgAmount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas     ShippingArea[]
  methods   ShippingMethodZone[]
  districts District[]
}

/// Bangladesh district (zilla) — Admin/checkout address selection (AD-254).
/// Maps to a ShippingZone for pricing (Dhaka → dhaka_metro, all others →
/// outside_dhaka). Seeded with the full official list.
model District {
  id       String @id @default(cuid())
  name     String @unique
  zoneId   String
  position Int    @default(0)

  zone     ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  upazilas Upazila[]

  @@index([zoneId])
}

/// Bangladesh upazila (sub-district) — the fine-grained checkout address
/// selection under a District (AD-254). Each upazila auto-provisions a
/// matching ShippingArea in its district's zone so the existing Cart/
/// Order/pricing pipeline needs no changes.
model Upazila {
  id             String  @id @default(cuid())
  districtId     String
  name           String
  /// The ShippingArea this upazila resolves to for cart/order selection.
  shippingAreaId String? @unique

  district     District      @relation(fields: [districtId], references: [id], onDelete: Cascade)
  shippingArea ShippingArea? @relation(fields: [shippingAreaId], references: [id], onDelete: SetNull)

  @@unique([districtId, name])
}

model ShippingArea {
  id        String   @id @default(cuid())
  zoneId    String
  cityId    String?
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone    ShippingZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  city    ShippingCity? @relation(fields: [cityId], references: [id], onDelete: SetNull)
  carts   Cart[]
  orders  Order[]
  upazila Upazila?

  @@unique([zoneId, name])
  @@index([cityId])
}

model ShippingMethod {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  description    String?
  baseRateAmount Int?
  currency       Currency @default(BDT)
  isPickup       Boolean  @default(false)
  isActive       Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  zones  ShippingMethodZone[]
  carts  Cart[]
  orders Order[]
}

model ShippingMethodZone {
  methodId   String
  zoneId     String
  rateAmount Int?

  method ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  zone   ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([methodId, zoneId])
  @@index([zoneId])
}

model ShippingCarrier {
  id                  String   @id @default(cuid())
  code                String   @unique
  name                String
  trackingUrlTemplate String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  orders Order[]
}

