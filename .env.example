# Copy to .env.local for machine-specific values.
# Do not put secrets in this file.
# Auth variables are used by the app already. Payment gateway secrets
# below are optional. Missing values keep hosted checkout deferred.
# Never commit real values. Do not add optional secrets to getEnv() —
# boot must succeed without them.

# --- Required (local + production) ---------------------------------

# PostgreSQL connection string (P10-T01).
# Create the role and database first — see docs/DATABASE.md.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/techno_house_dev?schema=public"

# Data source (legacy). Do not set this — the app requires PostgreSQL.
# DATA_SOURCE=mock is forbidden for a workable storefront/admin.
# DATA_SOURCE="mock"

# Signs the staff/customer session JWT (P19-T01). At least 32 random
# characters — generate with `openssl rand -base64 48` or similar. Changing
# this instantly invalidates every existing session (forces re-login).
SESSION_JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- Production / public origin (P18-T01) ---------------------------

# Public site origin (no trailing slash). Used for sitemap, robots,
# Open Graph metadataBase, and payment return / IPN base URLs.
# Local: optional (falls back to http://127.0.0.1:3000).
# Production: set to the real HTTPS origin before go-live.
# APP_URL="https://www.example.com"

# Optional override when gateway callbacks must use a different public base.
# PAYMENT_PUBLIC_BASE_URL="https://www.example.com"

# NODE_ENV is set by the host / process manager (development | production).
# Do not put NODE_ENV=production in .env.local for day-to-day Laragon work.

# Number of reverse proxies in front of the app (F-04).
#
# The client address keys every rate limit and every audit row. A proxy appends
# the address it received from, so the RIGHT-most X-Forwarded-For entry is the
# only part it vouches for — this says how far in from the right to read.
#
#   1  (default) one proxy: nginx, Caddy, a load balancer, Vercel
#   2+           that many proxies in front
#   0            app is directly exposed — X-Forwarded-For is ignored entirely
#
# Setting this too HIGH is safe (it reads a proxy address, not a client's).
# Setting it too LOW lets a client forge their own address. If unsure, count
# the hops between the public internet and this process.
# TRUSTED_PROXY_HOPS=1

# --- Auth / admin gate -------------------------------------------------

# Obscured staff sign-in path: /admin/access/{ADMIN_LOGIN_SLUG}
# 8-64 chars: letters, numbers, _ or - (must start alphanumeric).
# REQUIRED in production, and it must NOT be the development default below:
# that value is published here and in the repository history, so production
# refuses to start with it. Generate one, e.g. `openssl rand -hex 12`.
# Legacy /admin/login returns 404.
# ADMIN_LOGIN_SLUG="th-ops-local"

# --- Payments --------------------------------------------------------------

# Encrypts merchant secrets stored from Admin → Payment Methods (AD-207).
# Required to save SSLCommerz / bKash / Nagad credentials to the database.
#
# Use 32 random bytes, not a passphrase (F-06):
#     openssl rand -base64 48
#
# A full-entropy value (64 hex chars, or base64 decoding to >= 32 bytes) is
# used as the key directly. Anything else is treated as a passphrase and
# stretched with scrypt, and in production must be at least 32 characters.
# The same applies to STORAGE_SECRETS_KEY and COURIER_SECRETS_KEY.
# GATEWAY_SECRETS_KEY="change-me-to-a-long-random-string"

# Optional env fallback if admin DB settings are empty (legacy).
# Prefer configuring gateways in /admin/payments.

# SSLCommerz hosted checkout. Used only when DB settings are missing.
# SSLCOMMERZ_STORE_ID=""
# SSLCOMMERZ_STORE_PASSWORD=""
# SSLCOMMERZ_LIVE="false"

# --- Couriers ----------------------------------------------------------

# Encrypts Pathao/Steadfast credentials stored from Admin → Shipping →
# Select Shipping Method. Required to save them and to use the real
# "Send to Pathao/Steadfast" button on Admin → Orders (AD-253).
# COURIER_SECRETS_KEY="change-me-to-a-long-random-string"

# --- Storage / filesystem ---------------------------------------------

# Encrypts S3/Backblaze/Redis secrets stored from Admin → Settings →
# Filesystem. These settings are saved for reference only — uploads still
# always write to local disk; no S3/Backblaze/Redis client is wired yet.
# STORAGE_SECRETS_KEY="change-me-to-a-long-random-string"

# bKash tokenized checkout. Used only when DB settings are missing.
# BKASH_APP_KEY=""
# BKASH_APP_SECRET=""
# BKASH_USERNAME=""
# BKASH_PASSWORD=""
# BKASH_LIVE="false"

# --- Communication secrets (optional; never in DB) -----------------

# SMS gateway credentials (P16-T03). Optional. Never store these in the
# database. Used by Admin → OTP/SMS "Send test OTP". Field mapping depends
# on the selected provider (see lib/sms/send.ts): SID/username = SMS_API_KEY,
# token/auth secret = SMS_API_SECRET. The login/registration OTP flow itself
# (generate + verify codes) is still deferred.
# SMS_API_KEY=""
# SMS_API_SECRET=""

# SMTP password (P16-T04). Optional. Never store in the database.
# Host, port, username, and from fields persist in admin. Required to send
# real email (e.g. Admin → Contacts replies) when the SMTP mailer is selected.
# SMTP_PASSWORD=""

# --- Social / Google (optional; never in DB) -----------------------

# Social login / Google integration secrets (P16-T05). Optional. Never store
# in the database. OAuth, reCAPTCHA verify, and Firebase wiring are deferred.
# SOCIAL_GOOGLE_CLIENT_SECRET=""
# SOCIAL_FACEBOOK_APP_SECRET=""
# SOCIAL_TWITTER_API_SECRET=""
# SOCIAL_APPLE_CLIENT_SECRET=""
# RECAPTCHA_SECRET_KEY=""

# Google Maps API key (P16-T06). Optional. Never store in the database.
# Maps / Places wiring is deferred.
# GOOGLE_MAPS_API_KEY=""

# Meta Conversions API access token (AD-268). Optional. Never store in the
# database. Pixel ID/enabled state come from Admin → Meta Pixel. Required to
# send real server-side Purchase events on order placement; missing token
# fails closed (no request is sent). Generate in Events Manager → Settings →
# Conversions API.
# META_CAPI_ACCESS_TOKEN=""

# --- Abandoned-checkout stock release (F17 remainder) --------------

# An order reserves stock the moment it is placed, before the customer reaches
# the payment gateway. A customer who closes the tab leaves that stock held
# forever, so a sweep releases orders that never resolved.
#
# Hours an unpaid hosted-gateway order may hold stock before it is cancelled
# and its units returned. Defaults to 24. Cash-on-delivery orders are NEVER
# swept — they are legitimately unpaid until the rider is paid. An invalid or
# out-of-range value falls back to 24 rather than being clamped.
# STALE_ORDER_RELEASE_HOURS="24"

# Bearer token for POST /api/internal/sweep-stale-orders, so an external
# scheduler (Vercel Cron, host cron + curl, an uptime pinger) can run the
# sweep — this project has no cron of its own. Leave UNSET and the endpoint
# answers 404 and does not exist; the sweep can still be run by hand with
# `npm run orders:stale -- --apply`. Use a long random value.
# STALE_SWEEP_TOKEN=""
